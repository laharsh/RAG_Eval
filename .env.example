# ── LLM (use ollama while developing — saves Groq quota) ──
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Judge model (free tier: keep gpt-oss-20b + reasoning_effort=low)
GROQ_RAGAS_MODEL=openai/gpt-oss-20b
GROQ_RAGAS_MAX_TOKENS=8192
GROQ_RAGAS_TIMEOUT=300
GROQ_RAGAS_MAX_WORKERS=2
GROQ_RAGAS_REASONING_EFFORT=low
RAGAS_CONTEXT_MAX_CHARS=400
RAGAS_MAX_CONTEXT_CHUNKS=4

# ── Vector store (use faiss while developing — saves Pinecone quota) ──
VECTOR_BACKEND=faiss

PINECONE_API_KEY=your_key_here
PINECONE_INDEX=portfolio-rag
PINECONE_NAMESPACE=p1-governance

# ── Embeddings (always local — free) ──
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG settings ──
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=8
RRF_K=60
NEIGHBOR_WINDOW=1
MAX_CONTEXT_CHUNKS=10

# ── OpenSearch (BM25) — start with: docker compose up -d ──
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=governance-chunks

# ── Paths ──
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Hosted demo (Render) — FAISS-only, Groq on server
# HOSTED_DEMO=true
# CORS_ORIGINS=https://your-ui.onrender.com,http://localhost:5173
